PORT=5000
MONGO_URI=YOUR_MONGODB_ATLAS_CONNECTION_STRING
JWT_SECRET=GENERATE_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=30d
FRONTEND_URL=http://localhost:5173,http://localhost:5174
AUTO_SOS_ON_TIMEOUT=false

# Firebase Admin SDK for app-to-app push notifications.
# Put the complete JSON on one line in this variable, OR use a local JSON file.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"YOUR_PROJECT_ID"}
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
